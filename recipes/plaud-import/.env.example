# Copy to .env.local and fill in. .env.local is layered OVER the shell
# environment — the file wins, so a stale exported SUPABASE_URL cannot send this
# import to the wrong brain. Never commit .env.local.

# --- Required for a live import -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Embeddings (one of these) --------------------------------------------
# The MODEL is fixed to text-embedding-3-small and must not be changed:
# vectors from different embedding models are not comparable to each other.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Atomization (one of these; or use --no-llm / --provider claude-cli) ----
# OPENROUTER_API_KEY above is also used for atomization when set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini's OpenAI-compatible endpoint. Override only for a proxy.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Optional --------------------------------------------------------------
# Path to the Plaud CLI if it is not on PATH as `plaud`.
# PLAUD_BIN=/usr/local/bin/plaud
# Route embeddings through a local proxy or the recipe's mock test server.
# EMBEDDING_BASE_URL=http://127.0.0.1:8787/v1
# Set to 1 to include raw snippets in LLM error messages while debugging.
# PLAUD_DEBUG=0

# --- fetch-shared.mjs (public share links; no credentials needed) -----------
# Repair knobs only. Defaults work; set these if Plaud moves the endpoint or
# tightens the Cloudflare bot rule that 403s Node's default User-Agent.
# PLAUD_SHARE_API_BASE=https://api.plaud.ai
# PLAUD_SHARE_USER_AGENT=
